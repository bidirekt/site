#!/bin/sh
# Runs the Bidirekt petstore example: curl -sL bidirekt.com/try | sh
set -eu

TARBALL_URL=https://codeload.github.com/bidirekt/petstore-example/tar.gz/refs/heads/main
DIR=petstore-example

fail() {
  echo "bidirekt: $1" >&2
  exit 1
}

# Wrapped in a function so a truncated download never runs half a script.
main() {
  command -v docker >/dev/null 2>&1 ||
    fail "docker is not installed. Get Docker at https://docs.docker.com/get-docker/"
  docker compose version >/dev/null 2>&1 ||
    fail "docker compose is not available. Get it at https://docs.docker.com/compose/install/"

  if [ -e "$DIR" ]; then
    echo "Using the existing ./$DIR (not overwritten)."
  else
    if command -v curl >/dev/null 2>&1; then
      fetch="curl -fsSL"
    elif command -v wget >/dev/null 2>&1; then
      fetch="wget -qO-"
    else
      fail "neither curl nor wget is installed; install one of them to download the example."
    fi

    echo "Downloading the petstore example into ./$DIR ..."
    tmp=$(mktemp -d "$DIR.XXXXXX")
    trap 'rm -rf "$tmp"' EXIT
    $fetch "$TARBALL_URL" | tar -xz --strip-components=1 -C "$tmp"
    chmod 755 "$tmp"
    mv "$tmp" "$DIR"
    trap - EXIT
  fi

  cd "$DIR"
  echo "Starting the example with docker compose up ..."
  exec docker compose up
}

main
