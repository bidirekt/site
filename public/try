#!/bin/sh
# Sets up Bidirekt in your project: curl -sL bidirekt.com/try | sh
set -eu

CLI_VERSION=v0.1.0
COMPOSE_URL=https://raw.githubusercontent.com/bidirekt/broker/main/docker-compose.yaml
INSTALL_URL=https://raw.githubusercontent.com/bidirekt/cli/main/install.sh
# install.sh's default directory, which may be off PATH.
BIN_DIR=$HOME/.local/bin

fail() {
  echo "bidirekt: $1" >&2
  exit 1
}

# Asks on /dev/tty because stdin is this script when it is piped to sh.
confirm() {
  answer=
  if (: </dev/tty) 2>/dev/null; then
    printf 'Set up Bidirekt in %s? [Y/n] ' "$PWD" >/dev/tty
    read -r answer </dev/tty || answer=
  fi
  case $answer in
    [Nn]*) exit 0 ;;
  esac
}

# Wrapped in a function so a truncated download never runs half a script.
main() {
  confirm

  if [ -e bidirekt/compose.yaml ]; then
    echo "Kept the existing bidirekt/compose.yaml."
  else
    compose=$(curl -fsSL "$COMPOSE_URL") || fail "could not download $COMPOSE_URL"
    mkdir -p bidirekt
    printf '%s\n' "$compose" >bidirekt/compose.yaml
    echo "Downloaded the broker's compose file to bidirekt/compose.yaml."
  fi

  bin=$(command -v bidirekt) || bin=$BIN_DIR/bidirekt
  if [ "$("$bin" version 2>/dev/null)" = "bidirekt version ${CLI_VERSION#v}" ]; then
    echo "bidirekt ${CLI_VERSION#v} is already installed."
    command -v bidirekt >/dev/null 2>&1 ||
      printf '%s\n' "$BIN_DIR is not on your PATH. Add it in your shell profile:" "  export PATH=\"$BIN_DIR:\$PATH\""
  else
    # Not curl | sh: a failed download would run an empty script and exit 0.
    installer=$(curl -fsSL "$INSTALL_URL") || fail "could not download $INSTALL_URL"
    # A failed install, such as an OS or architecture without a build, says why and the setup goes on.
    printf '%s\n' "$installer" | sh -s -- "$CLI_VERSION" || true
  fi

  if command -v npx >/dev/null 2>&1; then
    npx -y skills add bidirekt/skills -a claude-code codex -y
  else
    echo "Install the agent skill with: npx skills add bidirekt/skills -a claude-code codex (needs Node.js)"
  fi

  docker compose version >/dev/null 2>&1 ||
    echo "The broker runs with Docker: https://docs.docker.com/get-docker/"

  cat <<'EOF'

Bidirekt is set up. Next:

1. Start the broker
   docker compose -f bidirekt/compose.yaml up -d

2. Point the CLI at it
   bidirekt configure --profile local --broker-url http://localhost:8080
   export BIDIREKT_PROFILE=local

3. Create the environment and one participant per service
   bidirekt create-environment production
   bidirekt create-participant <service>

4. Ask your coding agent
   Use the bidirekt skill to write the contract for this service.

5. Publish the contract
   bidirekt publish <files> --participant <service> --version <version>

6. Check before you deploy
   bidirekt can-i-deploy <service> --version <version> --environment production

7. After the deploy, record it
   bidirekt record-deployment <service> --version <version> --environment production

Walkthrough: https://bidirekt.com/docs/start/try
EOF
}

main
